#!/usr/bin/env bash
# bstag-module - Main BATTLESTAG module management command
# Usage: bstag-module <subcommand> [args...]

set -euo pipefail

BSTAG_HOME="${BSTAG_HOME:-$HOME/.bstag}"
AVAILABLE="$BSTAG_HOME/modules-available"
ENABLED="$BSTAG_HOME/modules-enabled"
CUSTOM="$BSTAG_HOME/modules-custom"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Print usage
usage() {
    cat << EOF
Usage: bstag-module <subcommand> [args...]

BATTLESTAG module management tool

SUBCOMMANDS:
  list         List enabled modules
  available    List all available modules
  info <name>  Show module information
  enable <name>   Enable a module (alias for bstag-enmod)
  disable <name>  Disable a module (alias for bstag-dismod)
  update       Update modules from git repo
  help         Show this help

EXAMPLES:
  bstag-module list
  bstag-module available
  bstag-module info csv_insight
  bstag-module enable csv_insight
  bstag-module disable csv_insight

SEE ALSO:
  bstag-enmod   - Enable modules
  bstag-dismod  - Disable modules
EOF
}

# List enabled modules
cmd_list() {
    echo -e "${BLUE}Enabled Modules:${NC}"
    echo ""

    if [[ ! -d "$ENABLED" ]] || [[ -z "$(ls -A "$ENABLED" 2>/dev/null)" ]]; then
        echo "  (none)"
        echo ""
        echo "Enable a module with: bstag-enmod <module_name>"
        return
    fi

    for link in "$ENABLED"/*.sh; do
        [[ -e "$link" ]] || continue

        module_name=$(basename "$link" .sh)
        source_file=$(readlink "$link")

        # Extract metadata
        tier="1"
        desc="No description"

        if [[ -f "$source_file" ]]; then
            tier=$(grep "^# TIER:" "$source_file" 2>/dev/null | sed 's/^# TIER: //' || echo "1")
            desc=$(grep "^# DESCRIPTION:" "$source_file" 2>/dev/null | sed 's/^# DESCRIPTION: //' || echo "No description")
        fi

        echo -e "  ${GREEN}●${NC} $module_name ${YELLOW}(Tier $tier)${NC}"
        echo "    $desc"
    done
}

# List available modules
cmd_available() {
    echo -e "${BLUE}Available Modules:${NC}"
    echo ""

    # Group by tier
    for tier in 1 2 3; do
        tier_dir="$AVAILABLE/tier$tier"
        if [[ ! -d "$tier_dir" ]]; then
            continue
        fi

        modules=$(find "$tier_dir" -name "*.sh" -type f 2>/dev/null || true)
        if [[ -z "$modules" ]]; then
            continue
        fi

        echo -e "${YELLOW}Tier $tier:${NC}"

        for module_file in $modules; do
            module_name=$(basename "$module_file" .sh)
            desc=$(grep "^# DESCRIPTION:" "$module_file" 2>/dev/null | sed 's/^# DESCRIPTION: //' || echo "No description")

            # Check if enabled
            if [[ -L "$ENABLED/${module_name}.sh" ]]; then
                echo -e "  ${GREEN}●${NC} $module_name - $desc ${GREEN}[enabled]${NC}"
            else
                echo "  ○ $module_name - $desc"
            fi
        done
        echo ""
    done

    # Custom modules
    if [[ -d "$CUSTOM" ]]; then
        custom_modules=$(find "$CUSTOM" -name "*.sh" -type f 2>/dev/null || true)
        if [[ -n "$custom_modules" ]]; then
            echo -e "${YELLOW}Custom Modules:${NC}"
            for module_file in $custom_modules; do
                module_name=$(basename "$module_file" .sh)
                desc=$(grep "^# DESCRIPTION:" "$module_file" 2>/dev/null | sed 's/^# DESCRIPTION: //' || echo "Custom module")

                if [[ -L "$ENABLED/${module_name}.sh" ]]; then
                    echo -e "  ${GREEN}●${NC} $module_name - $desc ${GREEN}[enabled]${NC}"
                else
                    echo "  ○ $module_name - $desc"
                fi
            done
        fi
    fi
}

# Show module info
cmd_info() {
    local module_name="${1:-}"

    if [[ -z "$module_name" ]]; then
        echo -e "${RED}Error: Module name required${NC}" >&2
        echo "Usage: bstag-module info <module_name>"
        exit 1
    fi

    # Find module
    module_file=$(find "$AVAILABLE" -name "${module_name}.sh" -type f 2>/dev/null | head -1)
    if [[ -z "$module_file" ]] && [[ -f "$CUSTOM/${module_name}.sh" ]]; then
        module_file="$CUSTOM/${module_name}.sh"
    fi

    if [[ -z "$module_file" ]]; then
        echo -e "${RED}Error: Module '$module_name' not found${NC}" >&2
        exit 1
    fi

    echo -e "${BLUE}Module Information:${NC}"
    echo ""
    echo "Name:        $module_name"

    # Extract all metadata
    grep "^# MODULE:" "$module_file" 2>/dev/null | sed 's/^# MODULE: /ID:          /' || true
    grep "^# NAME:" "$module_file" 2>/dev/null | sed 's/^# NAME: /Display:     /' || true
    grep "^# TIER:" "$module_file" 2>/dev/null | sed 's/^# TIER: /Tier:        /' || echo "Tier:        1"
    grep "^# CATEGORY:" "$module_file" 2>/dev/null | sed 's/^# CATEGORY: /Category:    /' || true
    grep "^# DESCRIPTION:" "$module_file" 2>/dev/null | sed 's/^# DESCRIPTION: /Description: /' || true

    echo ""
    echo "Location:    $module_file"

    # Check if enabled
    if [[ -L "$ENABLED/${module_name}.sh" ]]; then
        echo -e "Status:      ${GREEN}Enabled${NC}"
    else
        echo "Status:      Disabled"
    fi

    # Show parameters
    echo ""
    params=$(grep "^# PARAM:" "$module_file" 2>/dev/null || true)
    if [[ -n "$params" ]]; then
        echo "Parameters:"
        echo "$params" | sed 's/^# PARAM: /  /'
    fi
}

# Enable module (wrapper)
cmd_enable() {
    bstag-enmod "$@"
}

# Disable module (wrapper)
cmd_disable() {
    bstag-dismod "$@"
}

# Update modules
cmd_update() {
    echo -e "${BLUE}Updating BATTLESTAG modules...${NC}"
    echo ""
    echo "This requires running install script from the repo."
    echo ""
    echo "Steps:"
    echo "  1. cd /path/to/battlestag-bot-repo"
    echo "  2. git pull"
    echo "  3. ./SCRIPTS/install.sh --update"
    echo ""
}

# Main dispatcher
subcommand="${1:-help}"

case "$subcommand" in
    list)
        cmd_list
        ;;
    available)
        cmd_available
        ;;
    info)
        shift
        cmd_info "$@"
        ;;
    enable)
        shift
        cmd_enable "$@"
        ;;
    disable)
        shift
        cmd_disable "$@"
        ;;
    update)
        cmd_update
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        echo -e "${RED}Error: Unknown subcommand '$subcommand'${NC}" >&2
        echo ""
        usage
        exit 1
        ;;
esac
