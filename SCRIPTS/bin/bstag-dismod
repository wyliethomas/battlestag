#!/usr/bin/env bash
# bstag-dismod - Disable a BATTLESTAG module
# Usage: bstag-dismod <module_name>

set -euo pipefail

BSTAG_HOME="${BSTAG_HOME:-$HOME/.bstag}"
ENABLED="$BSTAG_HOME/modules-enabled"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Print usage
usage() {
    cat << EOF
Usage: bstag-dismod <module_name>

Disable a BATTLESTAG module by removing its symlink from modules-enabled/.

Examples:
  bstag-dismod csv_insight
  bstag-dismod improve_writing

Currently enabled modules:
EOF
    if [[ -d "$ENABLED" ]]; then
        ls -1 "$ENABLED" 2>/dev/null | sed 's/\.sh$//' | sed 's/^/  /' || echo "  (none)"
    else
        echo "  (none)"
    fi
}

# Main
module_name="${1:-}"

if [[ -z "$module_name" ]]; then
    echo -e "${RED}Error: Module name required${NC}" >&2
    echo ""
    usage
    exit 1
fi

link_target="$ENABLED/${module_name}.sh"

if [[ ! -L "$link_target" ]]; then
    echo -e "${RED}Error: Module '$module_name' is not enabled${NC}" >&2
    echo ""
    echo "Enabled modules:"
    if [[ -d "$ENABLED" ]]; then
        ls -1 "$ENABLED" 2>/dev/null | sed 's/\.sh$//' | sed 's/^/  /' || echo "  (none)"
    else
        echo "  (none)"
    fi
    exit 1
fi

# Show what we're removing
source_file=$(readlink "$link_target")

# Remove symlink
rm "$link_target"

echo -e "${GREEN}✓ Module '$module_name' disabled${NC}"
echo ""
echo "Removed: $link_target"
echo "Source was: $source_file"
echo ""
echo -e "${GREEN}Done!${NC}"
