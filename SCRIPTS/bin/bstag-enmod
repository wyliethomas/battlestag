#!/usr/bin/env bash
# bstag-enmod - Enable a BATTLESTAG module
# Usage: bstag-enmod <module_name>

set -euo pipefail

BSTAG_HOME="${BSTAG_HOME:-$HOME/.bstag}"
AVAILABLE="$BSTAG_HOME/modules-available"
ENABLED="$BSTAG_HOME/modules-enabled"
CUSTOM="$BSTAG_HOME/modules-custom"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Source utilities
source "$BSTAG_HOME/utilities/deps.sh" 2>/dev/null || true

# Print usage
usage() {
    cat << EOF
Usage: bstag-enmod <module_name>

Enable a BATTLESTAG module by creating a symlink in modules-enabled/.

Examples:
  bstag-enmod csv_insight
  bstag-enmod improve_writing
  bstag-enmod youtube_to_obsidian

Available modules:
EOF
    find "$AVAILABLE" -name "*.sh" -type f 2>/dev/null | \
        sed "s|$AVAILABLE/||" | \
        sed 's|^tier[0-9]/[^/]*/||' | \
        sed 's|\.sh$||' | \
        sort | \
        sed 's/^/  /'

    echo ""
    echo "Custom modules:"
    if [[ -d "$CUSTOM" ]]; then
        find "$CUSTOM" -name "*.sh" -type f 2>/dev/null | \
            sed "s|$CUSTOM/||" | \
            sed 's|\.sh$||' | \
            sort | \
            sed 's/^/  /' || echo "  (none)"
    else
        echo "  (none)"
    fi
}

# Check if bstag-config is available
has_config_tool() {
    command -v "$BSTAG_HOME/bin/bstag-config" &>/dev/null
}

# Main
module_name="${1:-}"

if [[ -z "$module_name" ]]; then
    echo -e "${RED}Error: Module name required${NC}" >&2
    echo ""
    usage
    exit 1
fi

# Ensure directories exist
mkdir -p "$ENABLED"

# Search for module in modules-available/
module_file=$(find "$AVAILABLE" -name "${module_name}.sh" -type f 2>/dev/null | head -1)

# Check custom/ too
if [[ -z "$module_file" ]] && [[ -f "$CUSTOM/${module_name}.sh" ]]; then
    module_file="$CUSTOM/${module_name}.sh"
fi

if [[ -z "$module_file" ]]; then
    echo -e "${RED}Error: Module '$module_name' not found${NC}" >&2
    echo ""
    echo "Available modules:"
    find "$AVAILABLE" -name "*.sh" -type f 2>/dev/null | \
        sed "s|$AVAILABLE/||" | \
        sed 's|^tier[0-9]/[^/]*/||' | \
        sed 's|\.sh$||' | \
        sort | \
        sed 's/^/  /'
    exit 1
fi

echo -e "${CYAN}=========================================${NC}"
echo -e "${CYAN}  Enabling Module: $module_name${NC}"
echo -e "${CYAN}=========================================${NC}"
echo ""

# Show module metadata
if grep -q "^# MODULE:" "$module_file" 2>/dev/null; then
    echo "Module Info:"
    grep "^# NAME:" "$module_file" | sed 's/^# NAME: /  Name: /' || true
    grep "^# TIER:" "$module_file" | sed 's/^# TIER: /  Tier: /' || echo "  Tier: 1"
    grep "^# DESCRIPTION:" "$module_file" | sed 's/^# DESCRIPTION: /  Desc: /'
    echo ""
fi

# Step 1: Check dependencies
echo -e "${BLUE}Step 1: Checking dependencies...${NC}"

has_missing_deps=false
missing_deps_list=()
missing_packages_list=()

while IFS= read -r dep; do
    [[ -z "$dep" ]] && continue
    if ! command -v "$dep" &>/dev/null; then
        echo -e "  ${YELLOW}✗ Missing: $dep${NC}"
        missing_deps_list+=("$dep")
        has_missing_deps=true
    else
        echo -e "  ${GREEN}✓ Found: $dep${NC}"
    fi
done < <(grep "^# DEPENDS:" "$module_file" 2>/dev/null | sed 's/^# DEPENDS: *//' || true)

if [[ "$has_missing_deps" == "false" ]]; then
    echo -e "  ${GREEN}✓ All dependencies satisfied${NC}"
fi

# Step 2: Install missing dependencies
if [[ "$has_missing_deps" == "true" ]]; then
    echo ""
    echo -e "${YELLOW}Missing dependencies detected!${NC}"
    echo ""

    # Detect package manager
    pkg_manager="unknown"
    if command -v pacman &>/dev/null; then
        pkg_manager="pacman"
    elif command -v apt &>/dev/null; then
        pkg_manager="apt"
    elif command -v dnf &>/dev/null; then
        pkg_manager="dnf"
    elif command -v brew &>/dev/null; then
        pkg_manager="brew"
    fi

    # Get packages to install
    while IFS= read -r pkg_line; do
        [[ -z "$pkg_line" ]] && continue

        # Parse package for current system
        case "$pkg_manager" in
            pacman)
                pkg=$(echo "$pkg_line" | grep -o "arch:[^ ]*" | cut -d: -f2 || true)
                ;;
            apt)
                pkg=$(echo "$pkg_line" | grep -o "debian:[^ ]*" | cut -d: -f2 || true)
                ;;
            dnf)
                pkg=$(echo "$pkg_line" | grep -o "fedora:[^ ]*" | cut -d: -f2 || true)
                ;;
            brew)
                pkg=$(echo "$pkg_line" | grep -o "brew:[^ ]*" | cut -d: -f2 || true)
                ;;
            *)
                pkg=$(echo "$pkg_line" | grep -o "pip:[^ ]*" | cut -d: -f2 || true)
                pkg_manager="pip"
                ;;
        esac

        [[ -n "$pkg" ]] && missing_packages_list+=("$pkg")
    done < <(grep "^# DEPENDS_PKG:" "$module_file" 2>/dev/null | sed 's/^# DEPENDS_PKG: *//' || true)

    if [[ ${#missing_packages_list[@]} -gt 0 ]]; then
        echo "Packages to install:"
        for pkg in "${missing_packages_list[@]}"; do
            echo "  - $pkg"
        done
        echo ""
        echo "Install command:"
        case "$pkg_manager" in
            pacman)
                echo "  sudo pacman -S ${missing_packages_list[*]}"
                ;;
            apt)
                echo "  sudo apt install ${missing_packages_list[*]}"
                ;;
            dnf)
                echo "  sudo dnf install ${missing_packages_list[*]}"
                ;;
            brew)
                echo "  brew install ${missing_packages_list[*]}"
                ;;
            pip)
                echo "  pip3 install --user ${missing_packages_list[*]}"
                ;;
        esac
        echo ""

        read -p "Install dependencies now? (y/N): " install_confirm
        if [[ "$install_confirm" =~ ^[Yy]$ ]]; then
            echo ""
            echo -e "${BLUE}Installing dependencies...${NC}"

            case "$pkg_manager" in
                pacman)
                    sudo pacman -S --noconfirm "${missing_packages_list[@]}"
                    ;;
                apt)
                    sudo apt-get install -y "${missing_packages_list[@]}"
                    ;;
                dnf)
                    sudo dnf install -y "${missing_packages_list[@]}"
                    ;;
                brew)
                    brew install "${missing_packages_list[@]}"
                    ;;
                pip)
                    pip3 install --user "${missing_packages_list[@]}"
                    ;;
            esac

            echo -e "${GREEN}✓ Dependencies installed${NC}"
        else
            echo -e "${YELLOW}Skipping dependency installation${NC}"
            echo -e "${YELLOW}Note: Module may not work without dependencies${NC}"
        fi
    fi
fi

# Step 3: Check required configuration
echo ""
echo -e "${BLUE}Step 2: Checking configuration...${NC}"

has_missing_config=false
required_configs=()

while IFS= read -r config_key; do
    [[ -z "$config_key" ]] && continue
    required_configs+=("$config_key")

    # Check if config is set
    if [[ -f "$BSTAG_HOME/config/llm.conf" ]]; then
        source "$BSTAG_HOME/config/llm.conf" 2>/dev/null || true
        if [[ -n "${!config_key:-}" ]]; then
            echo -e "  ${GREEN}✓ $config_key is configured${NC}"
        else
            echo -e "  ${YELLOW}✗ $config_key not set${NC}"
            has_missing_config=true
        fi
    else
        echo -e "  ${YELLOW}✗ $config_key not set${NC}"
        has_missing_config=true
    fi
done < <(grep "^# CONFIG_REQUIRED:" "$module_file" 2>/dev/null | sed 's/^# CONFIG_REQUIRED: *//' || true)

if [[ ${#required_configs[@]} -eq 0 ]]; then
    echo -e "  ${GREEN}✓ No configuration required${NC}"
fi

# Step 4: Prompt for missing configuration
if [[ "$has_missing_config" == "true" ]] && has_config_tool; then
    echo ""
    echo -e "${YELLOW}Configuration needed${NC}"
    echo ""

    for config_key in "${required_configs[@]}"; do
        # Check if already set
        if [[ -f "$BSTAG_HOME/config/llm.conf" ]]; then
            source "$BSTAG_HOME/config/llm.conf" 2>/dev/null || true
            [[ -n "${!config_key:-}" ]] && continue
        fi

        # Get prompt text
        prompt_text=$(grep -A1 "^# CONFIG_REQUIRED: $config_key" "$module_file" | \
                     grep "^# CONFIG_PROMPT:" | \
                     sed 's/^# CONFIG_PROMPT: *//' | \
                     sed 's/^"\(.*\)"$/\1/' || echo "Enter value for $config_key")

        # Get default value
        default_value=$(grep "^# CONFIG_DEFAULT:" "$module_file" | \
                       sed 's/^# CONFIG_DEFAULT: *//' | \
                       head -1 || true)

        echo -e "${CYAN}$config_key${NC}"
        echo "  $prompt_text"
        if [[ -n "$default_value" ]]; then
            read -p "  [$default_value]: " user_value
            user_value="${user_value:-$default_value}"
        else
            read -p "  > " user_value
        fi

        if [[ -n "$user_value" ]]; then
            # Expand tilde
            user_value="${user_value/#\~/$HOME}"
            "$BSTAG_HOME/bin/bstag-config" set "$config_key" "$user_value"
        fi
    done
fi

# Step 5: Create symlink
echo ""
echo -e "${BLUE}Step 3: Enabling module...${NC}"

link_target="$ENABLED/${module_name}.sh"

if [[ -L "$link_target" ]]; then
    echo -e "${YELLOW}Module '$module_name' is already enabled${NC}"
else
    ln -s "$module_file" "$link_target"
    echo -e "${GREEN}✓ Module enabled${NC}"
fi

# Final summary
echo ""
echo -e "${CYAN}=========================================${NC}"
echo -e "${GREEN}✓ Module '$module_name' is ready!${NC}"
echo -e "${CYAN}=========================================${NC}"
echo ""
echo "Usage:"
grep "^# PARAM:" "$module_file" 2>/dev/null | \
    sed 's/^# PARAM: */  /' | \
    head -2 || echo "  Run: $module_name"
echo ""
echo "Full path: $link_target"
